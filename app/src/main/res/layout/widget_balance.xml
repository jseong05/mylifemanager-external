<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_balance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_launcher_background"
    android:backgroundTint="#1E1E2C"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvWidgetBalanceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 마이 라이프 잔액 요약"
        android:textColor="#90CAF9"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetBalanceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0원"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetTodayExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="오늘 지출: 0원"
        android:textColor="#E0E0E0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWidgetRecommendedDaily"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="권장 지출액: 0원"
        android:textColor="#81D4FA"
        android:textSize="12sp" />
</LinearLayout>
